{
  "name": "discendo-sdk",
  "version": "0.1.0",
  "description": "Framework- and database-agnostic LMS logic SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./enrollment": {
      "types": "./dist/domains/enrollment/index.d.ts",
      "default": "./dist/domains/enrollment/index.js"
    },
    "./content": {
      "types": "./dist/domains/content/index.d.ts",
      "default": "./dist/domains/content/index.js"
    },
    "./assessment": {
      "types": "./dist/domains/assessment/index.d.ts",
      "default": "./dist/domains/assessment/index.js"
    },
    "./grading": {
      "types": "./dist/domains/grading/index.d.ts",
      "default": "./dist/domains/grading/index.js"
    },
    "./delegation": {
      "types": "./dist/domains/delegation/index.d.ts",
      "default": "./dist/domains/delegation/index.js"
    },
    "./guardians": {
      "types": "./dist/domains/guardians/index.d.ts",
      "default": "./dist/domains/guardians/index.js"
    },
    "./scheduling": {
      "types": "./dist/domains/scheduling/index.d.ts",
      "default": "./dist/domains/scheduling/index.js"
    },
    "./scheduling/calendar": {
      "types": "./dist/domains/scheduling/calendar/index.d.ts",
      "default": "./dist/domains/scheduling/calendar/index.js"
    },
    "./communication": {
      "types": "./dist/services/communication/index.d.ts",
      "default": "./dist/services/communication/index.js"
    },
    "./reporting": {
      "types": "./dist/services/reporting/index.d.ts",
      "default": "./dist/services/reporting/index.js"
    },
    "./admin": {
      "types": "./dist/services/admin/index.d.ts",
      "default": "./dist/services/admin/index.js"
    },
    "./interop": {
      "types": "./dist/interop/index.d.ts",
      "default": "./dist/interop/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/bun": "^1.4.2"
  }
}
